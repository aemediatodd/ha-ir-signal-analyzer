        "fan_step": { "name": "风速档位", "description": "自动或遥控器 0 至 6 档。" },
        "sleep": { "name": "睡眠", "description": "使用实测的睡眠和关指示灯命令。" },
        "soft_wind": { "name": "柔风", "description": "使用实测柔风命令；要求风速 5 档。" },
