        "swing_horizontal": { "name": "左右风", "description": "启用左右扫风。" },
        "auxiliary_heat": { "name": "辅热", "description": "启用实测辅热状态；目前仅在制热模式验证。" },
        "delay_ms": { "name": "2帧间隔", "description": "可选覆盖值；留空使用间隔实体的值。" }
