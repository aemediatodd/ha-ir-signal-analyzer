    "button": {
      "tcl_auxiliary_heat": { "default": "mdi:radiator" },
      "tcl_capture_validation": { "default": "mdi:remote" },
      "tcl_send_generated_test": { "default": "mdi:send" },
      "tcl_export_validated": { "default": "mdi:export" }
    }
